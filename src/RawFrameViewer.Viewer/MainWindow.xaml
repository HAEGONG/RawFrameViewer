<Window x:Class="RawFrameViewer.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RawFrameViewer.Viewer.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="RawFrameViewer (임상용 아님)" Height="940" Width="1440" WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="#DDDDDD" FontSize="13">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDDDDD" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#AAAAAA" />
            <Setter Property="BorderBrush" Value="#3C3C3C" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#999999" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 도구 모음: 연결, Window/Level, 보기 -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="8,6">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="호스트" Margin="0,0,4,0" />
                <TextBox Text="{Binding Host}" Width="100" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                <TextBlock Text="포트" Margin="8,0,4,0" />
                <TextBox Text="{Binding Port}" Width="55" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                <Button Content="{Binding ConnectButtonText}" Command="{Binding ToggleConnectionCommand}" MinWidth="80" />

                <Separator Margin="8,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />

                <TextBlock Text="Level" Margin="0,0,4,0" />
                <Slider Width="120" Minimum="0" Maximum="{Binding MaxPixelValue}" Value="{Binding WindowCenter}" VerticalAlignment="Center" />
                <TextBox Text="{Binding WindowCenter, StringFormat=F0}" Width="55" Margin="4,0" />
                <TextBlock Text="Window" Margin="8,0,4,0" />
                <Slider Width="120" Minimum="1" Maximum="{Binding MaxWindowWidth}" Value="{Binding WindowWidth}" VerticalAlignment="Center" />
                <TextBox Text="{Binding WindowWidth, StringFormat=F0}" Width="55" Margin="4,0" />
                <Button Content="자동 W/L" Command="{Binding AutoWindowLevelCommand}" />
                <CheckBox Content="반전" IsChecked="{Binding Invert}" Foreground="#DDDDDD" VerticalAlignment="Center" Margin="4,0" />

                <Separator Margin="8,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />

                <Button Content="화면 맞춤" Click="FitButton_Click" />
                <Button Content="1:1" Click="ActualSizeButton_Click" />

                <Separator Margin="8,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />

                <TextBlock Text="도구" Margin="0,0,6,0" />
                <RadioButton x:Name="PanToolButton" Content="이동" GroupName="Tool" IsChecked="True" Foreground="#DDDDDD" VerticalAlignment="Center" Margin="2,0" Checked="ToolButton_Checked" />
                <RadioButton x:Name="MeasureToolButton" Content="거리" GroupName="Tool" Foreground="#DDDDDD" VerticalAlignment="Center" Margin="6,0" Checked="ToolButton_Checked" />
                <RadioButton x:Name="RoiToolButton" Content="ROI" GroupName="Tool" Foreground="#DDDDDD" VerticalAlignment="Center" Margin="2,0" Checked="ToolButton_Checked" />
                <Button Content="측정 지우기" Command="{Binding ClearMeasurementsCommand}" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- 영상 영역. 확대·이동은 화면만의 상태이므로 코드 비하인드에서 처리한다. -->
            <Border x:Name="Viewport" Grid.Column="0" Background="#101010" ClipToBounds="True" Cursor="Cross"
                    MouseWheel="Viewport_MouseWheel"
                    MouseDown="Viewport_MouseDown"
                    MouseMove="Viewport_MouseMove"
                    MouseUp="Viewport_MouseUp"
                    MouseLeave="Viewport_MouseLeave"
                    SizeChanged="Viewport_SizeChanged">
                <Grid>
                    <Canvas>
                        <!-- 영상과 측정 도형을 같은 좌표계(영상 픽셀)에 두고 함께 확대·이동한다. -->
                        <Canvas x:Name="ImageLayer" RenderTransformOrigin="0,0">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ImageScale" />
                                    <TranslateTransform x:Name="ImageTranslate" />
                                </TransformGroup>
                            </Canvas.RenderTransform>
                            <Image x:Name="FrameImage" Source="{Binding Image}" Stretch="None" />
                            <Line x:Name="MeasureLine" Stroke="#FFD700" Visibility="Collapsed" IsHitTestVisible="False" />
                            <Rectangle x:Name="RoiRectangle" Stroke="#40C0FF" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Canvas>
                    </Canvas>
                    <!-- 연결이 끊긴 채 마지막 영상이 남아 있으면 실시간 영상이 아님을 분명히 표시한다. -->
                    <Border VerticalAlignment="Top" HorizontalAlignment="Stretch" Background="#CCB00020" Padding="10,6"
                            IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsShowingStaleImage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StaleImageText}" Foreground="White" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock HorizontalAlignment="Center" Foreground="#777777" FontSize="15"
                               Text="'연결'을 눌러 시뮬레이터(127.0.0.1:5000)에 접속하세요">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Image}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- 오른쪽 패널: 상태, 통계, 이벤트 로그 -->
            <DockPanel Grid.Column="1" Margin="8" LastChildFill="True">
                <GroupBox Header="연결" DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="12" Height="12" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#666666" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConnectionState}" Value="Connected">
                                            <Setter Property="Fill" Value="#4EC94E" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionState}" Value="Connecting">
                                            <Setter Property="Fill" Value="#E0C040" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionState}" Value="WaitingToReconnect">
                                            <Setter Property="Fill" Value="#E05050" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionStateText}" FontWeight="SemiBold" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="수신 통계" DockPanel.Dock="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource StatLabel}" Text="수신 / 표시 FPS" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource StatValue}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0:F1} / {1:F1}">
                                    <Binding Path="ReceiveFps" />
                                    <Binding Path="DisplayFps" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Grid.Row="1" Style="{StaticResource StatLabel}" Text="수신 프레임" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding Statistics.FramesReceived, FallbackValue=0}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource StatLabel}" Text="전송 지연 / 그리기 (ms)" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource StatValue}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0:F1} / {1:F1}" FallbackValue="- / -">
                                    <Binding Path="Statistics.LastLatencyMs" />
                                    <Binding Path="RenderMs" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Grid.Row="3" Style="{StaticResource StatLabel}" Text="누락 (FramesMissed)" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding Statistics.FramesMissed, FallbackValue=0}" />
                        <TextBlock Grid.Row="4" Style="{StaticResource StatLabel}" Text="영상 CRC 오류" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding Statistics.PayloadCrcErrors, FallbackValue=0}" />
                        <TextBlock Grid.Row="5" Style="{StaticResource StatLabel}" Text="재동기화 (SyncLost)" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding Statistics.SyncLostCount, FallbackValue=0}" />
                        <TextBlock Grid.Row="6" Style="{StaticResource StatLabel}" Text="중복 프레임" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding Statistics.DuplicateFrames, FallbackValue=0}" />
                        <TextBlock Grid.Row="7" Style="{StaticResource StatLabel}" Text="범위 초과 프레임" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding Statistics.PixelOutOfRangeFrames, FallbackValue=0}" />
                        <TextBlock Grid.Row="8" Style="{StaticResource StatLabel}" Text="타임아웃" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding Statistics.Timeouts, FallbackValue=0}" />
                        <TextBlock Grid.Row="9" Style="{StaticResource StatLabel}" Text="재연결" />
                        <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource StatValue}" Text="{Binding Statistics.Reconnects, FallbackValue=0}" />
                        <TextBlock Grid.Row="10" Style="{StaticResource StatLabel}" Text="할당 MB/s · Gen2/s · 힙 MB" />
                        <TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource StatValue}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0:F0} · {1:F1} · {2:F0}">
                                    <Binding Path="AllocationMBps" />
                                    <Binding Path="Gen2PerSecond" />
                                    <Binding Path="ManagedHeapMB" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Grid>
                </GroupBox>

                <GroupBox Header="측정" DockPanel.Dock="Top">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="거리" />
                        <TextBlock Text="{Binding MeasurementText}" FontFamily="Consolas" Foreground="#FFD700" />
                        <TextBlock Style="{StaticResource StatLabel}" Text="ROI" Margin="0,6,0,2" />
                        <TextBlock Text="{Binding RoiText}" FontFamily="Consolas" Foreground="#40C0FF" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="히스토그램 (전체 영상, √ 스케일)" DockPanel.Dock="Top">
                    <StackPanel>
                        <Viewbox Stretch="Fill" Height="80">
                            <Canvas Width="256" Height="100" Background="#151515" ClipToBounds="True">
                                <Path Data="{Binding HistogramGeometry}" Fill="#8899AA" />
                                <Line X1="{Binding WindowLowerX}" X2="{Binding WindowLowerX}" Y1="0" Y2="100" Stroke="#FFA040" StrokeThickness="1.5" />
                                <Line X1="{Binding WindowUpperX}" X2="{Binding WindowUpperX}" Y1="0" Y2="100" Stroke="#FFA040" StrokeThickness="1.5" />
                            </Canvas>
                        </Viewbox>
                        <DockPanel Margin="0,2,0,0">
                            <TextBlock Text="0" FontSize="11" Foreground="#888888" />
                            <TextBlock Text="{Binding MaxPixelValue, StringFormat=N0}" FontSize="11" Foreground="#888888" DockPanel.Dock="Right" />
                            <TextBlock Text="주황선 = 현재 Window 범위" FontSize="11" Foreground="#FFA040" HorizontalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="이벤트 로그">
                    <ListBox ItemsSource="{Binding Log}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LogEntry}">
                                <StackPanel Margin="0,1">
                                    <TextBlock FontFamily="Consolas" FontSize="11" Foreground="#888888">
                                        <Run Text="{Binding Time, Mode=OneWay}" />
                                        <Run Text="{Binding Kind, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#CCCCCC" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                        <Setter Property="Foreground" Value="#E0C040" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                                        <Setter Property="Foreground" Value="#F06060" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>
            </DockPanel>
        </Grid>

        <!-- 상태 표시줄 -->
        <Border Grid.Row="2" Background="#007ACC" Padding="8,3">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="White"
                           Text="휠: 확대/축소 · 왼쪽: 선택한 도구 · 가운데: 이동 · 오른쪽: W/L · 더블클릭: 화면 맞춤" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="White" Text="{Binding FrameInfo}" MinWidth="220" />
                    <TextBlock x:Name="ZoomText" Foreground="White" MinWidth="90" />
                    <TextBlock Foreground="White" Text="{Binding CursorInfo}" FontFamily="Consolas" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
